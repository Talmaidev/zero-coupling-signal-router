diff --git a/include/zcsr/culling.h b/include/zcsr/culling.h
new file mode 100644
index 0000000..6b83c7a
--- /dev/null
+++ b/include/zcsr/culling.h
@@ -0,0 +1,75 @@
+/* zcsr culling — viewport culling for 2D AABBs. Pure logic, no GL, no heap.
+ *
+ * Two strategies:
+ *   - linear: test every box against the view (O(n), cache-friendly).
+ *   - uniform grid: hash boxes into fixed-size cells, then walk only the cells the
+ *     view overlaps (fast when the view covers a small fraction of the world).
+ *
+ * The caller owns all memory: the box array, the grid scratch, and the output index list.
+ */
+#ifndef ZCSR_CULLING_H
+#define ZCSR_CULLING_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Axis-aligned box in world/pixel coordinates. */
+typedef struct {
+    float min_x, min_y;
+    float max_x, max_y;
+} zcsr_aabb_t;
+
+/* Visible region (camera/viewport) in the same coordinate space. */
+typedef struct {
+    float min_x, min_y;
+    float max_x, max_y;
+} zcsr_view_t;
+
+/* Returns 1 if the box intersects the view (inclusive edges), else 0. */
+int zcsr_aabb_in_view(const zcsr_aabb_t* box, const zcsr_view_t* view);
+
+/* Linear cull: test every box. Writes the indices of visible boxes into out_indices and
+ * returns the count. Stops early if out_capacity is reached. */
+size_t zcsr_cull_linear(const zcsr_aabb_t* boxes, size_t count,
+                        const zcsr_view_t* view,
+                        uint32_t* out_indices, size_t out_capacity);
+
+/* ---- uniform grid ---- */
+typedef struct {
+    float origin_x, origin_y;   /* world coordinate of cell (0,0) corner */
+    float cell_w, cell_h;       /* cell size (pixels) */
+    uint32_t cols, rows;        /* grid dimensions */
+    /* Packed linked-list storage. cell_head[c] is the first box index in cell c, or
+     * ZCSR_CULL_EMPTY; next[b] is the next box in that cell, or ZCSR_CULL_EMPTY. */
+    uint32_t* cell_head;        /* length cols*rows */
+    uint32_t* next;             /* length box_count */
+} zcsr_grid_t;
+
+#define ZCSR_CULL_EMPTY 0xFFFFFFFFu
+
+/* Build a grid: clear the heads, then insert each box into every cell it overlaps.
+ * Returns the number of (box, cell) insertions performed. A box larger than a cell is
+ * inserted into multiple cells. The caller must size cell_head and next. */
+size_t zcsr_grid_build(zcsr_grid_t* grid, const zcsr_aabb_t* boxes, size_t count);
+
+/* Query the grid for boxes overlapping the view. Writes de-duplicated visible box indices
+ * into out_indices (the 'seen' array, length box_count, is used to dedupe and is cleared
+ * internally). A box is returned only if its AABB truly intersects the view, since a large
+ * box can be linked from a cell just outside the view. Returns the visible count. */
+size_t zcsr_grid_query(const zcsr_grid_t* grid, const zcsr_aabb_t* boxes, size_t box_count,
+                       const zcsr_view_t* view,
+                       uint32_t* out_indices, size_t out_capacity,
+                       uint8_t* seen);
+
+/* Fraction of the world covered by the view (0..1), to choose a strategy. */
+float zcsr_view_coverage(const zcsr_grid_t* grid, const zcsr_view_t* view);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZCSR_CULLING_H */
diff --git a/include/zcsr/gl_render.h b/include/zcsr/gl_render.h
index 0bd0d58..8d5b98e 100644
--- a/include/zcsr/gl_render.h
+++ b/include/zcsr/gl_render.h
@@ -24,6 +24,8 @@ typedef uint32_t zcsr_gl_texture;                 /* GPU texture handle; 0 = inv
 zcsr_gl_renderer* zcsr_gl_create(zcsr_surface* surface, void* buffer, size_t bytes);
 void              zcsr_gl_destroy(zcsr_gl_renderer*);
 void              zcsr_gl_set_vsync(zcsr_gl_renderer*, bool on);
+/* Swap front/back buffers (present). Call after draw_instances when targeting the window. */
+void              zcsr_gl_present(zcsr_gl_renderer*);
 
 /* Upload 8-bit RGBA pixels to a GPU texture. `linear` = linear filter (else nearest). */
 zcsr_gl_texture   zcsr_gl_texture_create(zcsr_gl_renderer*, const uint8_t* rgba, int w, int h);
@@ -81,4 +83,60 @@ typedef struct {
  * share one atlas texture are coalesced into a single glDrawArrays. */
 void zcsr_gl_submit_atlas_batch(zcsr_gl_renderer*, const zcsr_gl_atlas_sprite* sprites, size_t count);
 
+/* ---- Instanced rendering ----------------------------------------------------------------------
+ * One draw call (glDrawElementsInstanced) expands a single unit quad into N instances. Only the
+ * per-instance data is uploaded (60 bytes each), instead of 6 full vertices per sprite (216 bytes),
+ * so both CPU vertex setup and GPU transfer shrink. The rotation/quad expansion moves into the
+ * vertex shader. Best for large counts of same-texture sprites. */
+typedef struct {
+    float cx, cy;          /* center position (pixels) */
+    float w, h;            /* size (pixels) */
+    float u0, v0, u1, v1;  /* atlas UV sub-rectangle (use 0,0,1,1 for a full texture) */
+    float r, g, b, a;      /* modulation color 0..1 */
+    float rotation;        /* radians, about the center */
+    float amount;          /* blend strength for MIX/ADD */
+    float mode;            /* zcsr_color_mode as float */
+    uint32_t tex;          /* CPU-only: texture handle, used for sorting into runs */
+    float z;               /* CPU-only: depth/layer; larger = farther, drawn first (painter's) */
+} zcsr_gl_instance;        /* 15 float attrs + uint32 + float = 68 bytes; tex/z are CPU-only */
+
+/* Draw `count` instances sharing one bound texture, in one instanced draw call. Instances are
+ * drawn as-is (no sorting). For a batch spanning multiple textures, sort it first (see
+ * zcsr_sort_instances) then call this once per texture run, or use submit_instance_batch. */
+void zcsr_gl_draw_instances(zcsr_gl_renderer*, zcsr_gl_texture texture,
+                            const zcsr_gl_instance* instances, size_t count);
+
+/* Sort a writable instance array into texture runs (and blend mode within a texture) so that
+ * drawing needs one state setup per run. Pure CPU, no heap: `temp` is caller scratch of at least
+ * `count * sizeof(zcsr_gl_instance)` bytes. Returns the number of distinct texture runs. After
+ * sorting, iterate runs with zcsr_instance_run to get each run's texture/start/count. */
+size_t zcsr_sort_instances(zcsr_gl_instance* instances, size_t count, void* temp);
+
+/* Describe one texture run produced by zcsr_sort_instances. `run_index` in 0..return-1.
+ * Writes the texture and the [start,start+len) slice of the sorted array. */
+void zcsr_instance_run(const zcsr_gl_instance* sorted, size_t count, size_t run_index,
+                       zcsr_gl_texture* out_texture, size_t* out_start, size_t* out_len);
+
+/* Convenience: sort and draw all instances (one instanced call per texture run). `temp` is
+ * caller scratch (>= count * sizeof instance). */
+void zcsr_gl_submit_instance_batch(zcsr_gl_renderer*, zcsr_gl_instance* instances, size_t count,
+                                   void* temp, size_t temp_bytes);
+
+/* ---- full state sort (opaque vs translucent) ----
+ * An instance is treated as translucent when its alpha < 1.0 or its color mode is MIX/ADD.
+ * Partitions the array into opaque instances first (sorted by texture, for batching) then
+ * translucent instances sorted back-to-front by z (larger z = farther, painter's algorithm).
+ * Returns the number of opaque instances. After sorting:
+ *   - draw [0, opaque) via texture runs (zcsr_instance_run / zcsr_gl_draw_instances),
+ *   - draw [opaque, count) in array order, grouping only adjacent same-texture instances.
+ * `temp` is caller scratch (>= count * sizeof instance). */
+size_t zcsr_sort_state(zcsr_gl_instance* instances, size_t count, void* temp,
+                       size_t* out_opaque);
+
+/* Convenience: full state sort + draw. Opaque instances are drawn in texture runs;
+ * translucent instances are drawn back-to-front, flushing on texture changes. Presents at the
+ * end when targeting the window. `temp` is caller scratch (>= count * sizeof instance). */
+void zcsr_gl_submit_state(zcsr_gl_renderer*, zcsr_gl_instance* instances, size_t count,
+                          void* temp, size_t temp_bytes);
+
 #endif /* ZCSR_GL_RENDER_H */
diff --git a/modules/culling/culling.c b/modules/culling/culling.c
new file mode 100644
index 0000000..7f53de6
--- /dev/null
+++ b/modules/culling/culling.c
@@ -0,0 +1,106 @@
+#include "zcsr/culling.h"
+
+int zcsr_aabb_in_view(const zcsr_aabb_t* b, const zcsr_view_t* v) {
+    if (!b || !v) return 0;
+    return b->min_x <= v->max_x && b->max_x >= v->min_x &&
+           b->min_y <= v->max_y && b->max_y >= v->min_y;
+}
+
+size_t zcsr_cull_linear(const zcsr_aabb_t* boxes, size_t count,
+                        const zcsr_view_t* view,
+                        uint32_t* out_indices, size_t out_capacity) {
+    size_t i, n = 0;
+    if (!boxes || !view || !out_indices) return 0;
+    for (i = 0; i < count; ++i) {
+        if (zcsr_aabb_in_view(&boxes[i], view)) {
+            if (n >= out_capacity) return n;
+            out_indices[n++] = (uint32_t)i;
+        }
+    }
+    return n;
+}
+
+static uint32_t zcsr_clamp_i(int v, int lo, int hi) {
+    if (v < lo) return (uint32_t)lo;
+    if (v > hi) return (uint32_t)hi;
+    return (uint32_t)v;
+}
+
+size_t zcsr_grid_build(zcsr_grid_t* g, const zcsr_aabb_t* boxes, size_t count) {
+    uint32_t cells, c, r;
+    size_t i, inserts = 0;
+    if (!g || !boxes || !g->cell_head || !g->next) return 0;
+    cells = g->cols * g->rows;
+    for (c = 0; c < cells; ++c) g->cell_head[c] = ZCSR_CULL_EMPTY;
+
+    for (i = 0; i < count; ++i) {
+        const zcsr_aabb_t* b = &boxes[i];
+        int c0 = (int)((b->min_x - g->origin_x) / g->cell_w);
+        int c1 = (int)((b->max_x - g->origin_x) / g->cell_w);
+        int r0 = (int)((b->min_y - g->origin_y) / g->cell_h);
+        int r1 = (int)((b->max_y - g->origin_y) / g->cell_h);
+        uint32_t x0 = zcsr_clamp_i(c0, 0, (int)g->cols - 1);
+        uint32_t x1 = zcsr_clamp_i(c1, 0, (int)g->cols - 1);
+        uint32_t y0 = zcsr_clamp_i(r0, 0, (int)g->rows - 1);
+        uint32_t y1 = zcsr_clamp_i(r1, 0, (int)g->rows - 1);
+        g->next[i] = ZCSR_CULL_EMPTY;
+        for (r = y0; r <= y1; ++r) {
+            for (c = x0; c <= x1; ++c) {
+                uint32_t cell = r * g->cols + c;
+                g->next[i] = g->cell_head[cell];
+                g->cell_head[cell] = (uint32_t)i;
+                ++inserts;
+            }
+        }
+    }
+    return inserts;
+}
+
+size_t zcsr_grid_query(const zcsr_grid_t* g, const zcsr_aabb_t* boxes, size_t box_count,
+                       const zcsr_view_t* view,
+                       uint32_t* out_indices, size_t out_capacity,
+                       uint8_t* seen) {
+    int c0, c1, r0, r1;
+    uint32_t x0, x1, y0, y1, r, c;
+    size_t i, n = 0;
+    if (!g || !boxes || !view || !out_indices || !seen) return 0;
+    for (i = 0; i < box_count; ++i) seen[i] = 0;
+
+    c0 = (int)((view->min_x - g->origin_x) / g->cell_w);
+    c1 = (int)((view->max_x - g->origin_x) / g->cell_w);
+    r0 = (int)((view->min_y - g->origin_y) / g->cell_h);
+    r1 = (int)((view->max_y - g->origin_y) / g->cell_h);
+    x0 = zcsr_clamp_i(c0, 0, (int)g->cols - 1);
+    x1 = zcsr_clamp_i(c1, 0, (int)g->cols - 1);
+    y0 = zcsr_clamp_i(r0, 0, (int)g->rows - 1);
+    y1 = zcsr_clamp_i(r1, 0, (int)g->rows - 1);
+
+    for (r = y0; r <= y1; ++r) {
+        for (c = x0; c <= x1; ++c) {
+            uint32_t idx = g->cell_head[r * g->cols + c];
+            while (idx != ZCSR_CULL_EMPTY) {
+                if (!seen[idx] && zcsr_aabb_in_view(&boxes[idx], view)) {
+                    seen[idx] = 1;
+                    if (n < out_capacity) out_indices[n++] = idx;
+                }
+                idx = g->next[idx];
+            }
+        }
+    }
+    return n;
+}
+
+float zcsr_view_coverage(const zcsr_grid_t* g, const zcsr_view_t* v) {
+    float world_w, world_h, view_w, view_h;
+    if (!g || !v) return 1.0f;
+    world_w = g->cell_w * (float)g->cols;
+    world_h = g->cell_h * (float)g->rows;
+    view_w = v->max_x - v->min_x;
+    view_h = v->max_y - v->min_y;
+    if (world_w <= 0 || world_h <= 0) return 1.0f;
+    if (view_w < 0) view_w = 0;
+    if (view_h < 0) view_h = 0;
+    if (view_w > world_w) view_w = world_w;
+    if (view_h > world_h) view_h = world_h;
+    return (view_w * view_h) / (world_w * world_h);
+}
diff --git a/modules/glrender/glrender.c b/modules/glrender/glrender.c
index e7a4ccf..a2213c5 100644
--- a/modules/glrender/glrender.c
+++ b/modules/glrender/glrender.c
@@ -95,6 +95,69 @@ static unsigned int zcsr_gl_make_program(void) {
     return p;
 }
 
+static unsigned int zcsr_gl_make_inst_program(void) {
+    /* Unit-quad corner (per-vertex) + per-instance attributes (divisor 1). The vertex shader
+     * expands the corner into the rotated quad, so the CPU only uploads instance data. */
+    static const char* vs =
+        "#version 330 core\n"
+        "layout(location=0) in vec2 a_corner;\n"
+        "layout(location=1) in vec2 i_center;\n"
+        "layout(location=2) in vec2 i_size;\n"
+        "layout(location=3) in vec4 i_uv;\n"
+        "layout(location=4) in vec4 i_color;\n"
+        "layout(location=5) in float i_rotation;\n"
+        "layout(location=6) in float i_amount;\n"
+        "layout(location=7) in float i_mode;\n"
+        "uniform vec2 u_view;\n"
+        "out vec2 v_uv;\n"
+        "out vec4 v_color;\n"
+        "out vec2 v_mod;\n"
+        "void main(){\n"
+        "  vec2 halfsize = i_size * 0.5;\n"
+        "  float c = cos(i_rotation);\n"
+        "  float s = sin(i_rotation);\n"
+        "  vec2 local = a_corner * halfsize;\n"
+        "  vec2 pos = i_center + vec2(local.x*c - local.y*s, local.x*s + local.y*c);\n"
+        "  gl_Position = vec4((pos.x / u_view.x) * 2.0 - 1.0, 1.0 - (pos.y / u_view.y) * 2.0, 0.0, 1.0);\n"
+        "  vec2 t = a_corner * 0.5 + 0.5;\n"
+        "  v_uv = mix(i_uv.xy, i_uv.zw, t);\n"
+        "  v_color = i_color; v_mod = vec2(i_mode, i_amount);\n"
+        "}\n";
+    static const char* fs =
+        "#version 330 core\n"
+        "in vec2 v_uv;\n"
+        "in vec4 v_color;\n"
+        "in vec2 v_mod;\n"
+        "uniform sampler2D u_tex;\n"
+        "out vec4 o_color;\n"
+        "void main(){\n"
+        "  vec4 texel = texture(u_tex, v_uv);\n"
+        "  float amount = clamp(v_mod.y, 0.0, 1.0);\n"
+        "  if (v_mod.x < 0.5) o_color = texel * v_color;\n"
+        "  else if (v_mod.x < 1.5) o_color = mix(texel, v_color, amount);\n"
+        "  else o_color = clamp(texel + v_color * amount, 0.0, 1.0);\n"
+        "}\n";
+    unsigned int v = zcsr_gl_compile(GL_VERTEX_SHADER, vs);
+    unsigned int f = zcsr_gl_compile(GL_FRAGMENT_SHADER, fs);
+    unsigned int p;
+    int ok = 0;
+    if (!v || !f) {
+        if (v) glDeleteShader(v);
+        if (f) glDeleteShader(f);
+        return 0;
+    }
+    p = glCreateProgram();
+    if (!p) { glDeleteShader(v); glDeleteShader(f); return 0; }
+    glAttachShader(p, v);
+    glAttachShader(p, f);
+    glLinkProgram(p);
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    glDeleteShader(v);
+    glDeleteShader(f);
+    if (!ok) { glDeleteProgram(p); return 0; }
+    return p;
+}
+
 static unsigned int zcsr_gl_create_white_texture(void) {
     unsigned char px[4] = { 255, 255, 255, 255 };
     unsigned int tex = 0;
@@ -193,6 +256,10 @@ static void zcsr_gl_record_draw(zcsr_gl_renderer* r, unsigned int texture, size_
     r->draws[r->draw_count++] = (zcsr_gl_draw){ texture, first, count };
 }
 
+/* Instanced resource setup/teardown (defined below, after the shared GL init). */
+static bool zcsr_gl_init_inst(zcsr_gl_renderer* r);
+static void zcsr_gl_destroy_inst(zcsr_gl_renderer* r);
+
 /* Allocate the shared GPU resources (program, VAO/VBO, FBO, white texture). Runs after a context
  * is current and the GL function table is loaded. */
 static bool zcsr_gl_init_gl(zcsr_gl_renderer* r) {
@@ -219,6 +286,7 @@ static bool zcsr_gl_init_gl(zcsr_gl_renderer* r) {
     r->white_tex = zcsr_gl_create_white_texture();
     glEnable(GL_BLEND);
     glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    if (!zcsr_gl_init_inst(r)) return false;
     return r->vao != 0 && r->vbo != 0 && r->fbo != 0 && r->white_tex != 0;
 }
 
@@ -232,6 +300,69 @@ static void zcsr_gl_destroy_gl(zcsr_gl_renderer* r) {
     if (r->vbo) glDeleteBuffers(1, &r->vbo);
     if (r->vao) glDeleteVertexArrays(1, &r->vao);
     if (r->program) glDeleteProgram(r->program);
+    zcsr_gl_destroy_inst(r);
+}
+static bool zcsr_gl_init_inst(zcsr_gl_renderer* r) {
+    static const float corners[8] = {
+        -1.f, -1.f,   1.f, -1.f,   1.f, 1.f,   -1.f, 1.f
+    };
+    static const unsigned short indices[6] = { 0, 1, 2, 0, 2, 3 };
+    const size_t stride = sizeof(zcsr_gl_instance);
+
+    r->inst_program = zcsr_gl_make_inst_program();
+    if (!r->inst_program) return false;
+    r->inst_uniform_view = glGetUniformLocation(r->inst_program, "u_view");
+    r->inst_uniform_tex  = glGetUniformLocation(r->inst_program, "u_tex");
+
+    glGenVertexArrays(1, &r->inst_vao);
+    glBindVertexArray(r->inst_vao);
+
+    glGenBuffers(1, &r->inst_corner_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, r->inst_corner_vbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof corners, corners, GL_STATIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), (void*)0);
+
+    glGenBuffers(1, &r->inst_ebo);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, r->inst_ebo);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof indices, indices, GL_STATIC_DRAW);
+
+    glGenBuffers(1, &r->inst_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, r->inst_vbo);
+    glBufferData(GL_ARRAY_BUFFER, ZCSR_GL_MAX_INSTANCES * stride, NULL, GL_DYNAMIC_DRAW);
+
+    glEnableVertexAttribArray(1);
